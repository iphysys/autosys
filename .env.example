# Copy to .env (gitignored) and fill in the values. Never commit them.

# Password of the development Postgres in deploy/compose/.
AUTOSYS_DB_PASSWORD=

# The same database: postgres://autosys:<password>@127.0.0.1:5432/autosys
# Used by sqlx's compile-time query checks, `cargo xtask ci` and the store
# tests, which create and drop their own databases on this server.
DATABASE_URL=

# Model gateway (config/models/routing.yaml, ADR-0027, ADR-0036). Read at
# startup; a variable of a profile in use that is missing fails startup,
# naming it.
# The internal Pliny platform: its API key, sent as a bearer token, and its
# OpenAI-compatible base URL.
PLINY_API_KEY=
PLINY_BASE_URL=
# Optional: path of a PEM bundle of internal CAs, trusted in addition to the
# system roots. TLS verification stays on.
INTERNAL_CA_BUNDLE=
# Optional: a profile name that replaces default_profile for this run.
# SYNTH_MODEL_PROFILE=

# Worker (apps/worker, ADR-0031).
# Where the harness runs: local, test or production. Unset means production,
# whose rules the committed config/ must meet.
# SYNTH_ENVIRONMENT=
# The worker's id, unless --id gives one. Default: worker-<pid>-<start ms>.
# SYNTH_WORKER_ID=
# Log filter for the binaries, for example info or runtime=debug.
# RUST_LOG=info

# API server (apps/api-server, ADR-0018).
# The development token every request must carry (ADR-0022): a long random
# string, for a developer's machine only. api-server does not start without it.
SYNTH_API_TOKEN=
