# Copy to .env (gitignored) and fill in the values. Never commit them.

# Password of the development Postgres in deploy/compose/.
AUTOSYS_DB_PASSWORD=

# The same database: postgres://autosys:<password>@127.0.0.1:5432/autosys
# Used by sqlx's compile-time query checks, `cargo xtask ci` and the store
# tests, which create and drop their own databases on this server.
DATABASE_URL=

# Model gateway (config/models/routing.yaml, ADR-0027). Read at startup; a
# variable of a profile in use that is missing fails startup, naming it.
# Claude API key, sent as a bearer token.
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to one workspace: the workspace ID
# (wrkspc_...), sent as anthropic-workspace-id.
ANTHROPIC_WORKSPACE_ID=
# The internal Pliny platform: its API key and its OpenAI-compatible base URL.
PLINY_API_KEY=
PLINY_BASE_URL=
# Optional: path of a PEM bundle of internal CAs, trusted in addition to the
# system roots. TLS verification stays on.
INTERNAL_CA_BUNDLE=
# Optional: a profile name that replaces default_profile for this run.
# SYNTH_MODEL_PROFILE=
