{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shared definitions used by the other schemas. Has no root type.",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "description": "A stable identifier. Not a display name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "JobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "AgentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ToolName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "CheckId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "StepId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "CorrelationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ElementId": {
      "description": "Identity of an SDR element. Unique across the whole SDR document.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TransitionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ApprovalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "SdrVersion": {
      "description": "A linear SDR version. Version 0 is the empty design.",
      "type": "integer",
      "minimum": 0
    },
    "Timestamp": {
      "description": "RFC 3339 date-time; the timezone offset is required.",
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "SchemaPath": {
      "description": "Path of a schema file relative to schemas/.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*\\.schema\\.json$"
    },
    "Actor": {
      "description": "Who performed an action. A provenance record, not an authentication result.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "agent_id"],
          "properties": {
            "kind": { "const": "agent" },
            "agent_id": { "$ref": "#/$defs/AgentId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "user_id"],
          "properties": {
            "kind": { "const": "user" },
            "user_id": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "component"],
          "properties": {
            "kind": { "const": "system" },
            "component": { "$ref": "#/$defs/Identifier" }
          }
        }
      ]
    },
    "StopReason": {
      "description": "Why a run or task stopped (blueprint section 5.4).",
      "type": "string",
      "enum": ["success", "failure", "budget_exhausted", "cancelled", "approval_required"]
    },
    "ErrorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "description": "Stable machine-readable error code.",
          "$ref": "#/$defs/Identifier"
        },
        "message": { "$ref": "#/$defs/NonEmptyString" },
        "retryable": { "type": "boolean" },
        "correlation_id": { "$ref": "#/$defs/CorrelationId" }
      }
    },
    "Budget": {
      "description": "Upper limits for a task or agent. Every limit is required so no run is unbounded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_tool_calls", "max_steps", "max_wall_time_seconds", "max_repair_attempts"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_steps": { "type": "integer", "minimum": 1 },
        "max_wall_time_seconds": { "type": "integer", "minimum": 1 },
        "max_repair_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "tool_calls", "steps", "wall_time_seconds"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "steps": { "type": "integer", "minimum": 0 },
        "wall_time_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "VersionedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "version": { "$ref": "#/$defs/SemVer" },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "HarnessVersions": {
      "description": "Versions of everything that shaped behavior, recorded for provenance and rollback.",
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_build", "model_ids", "prompts", "skills", "agent_specs"],
      "properties": {
        "harness_build": { "$ref": "#/$defs/NonEmptyString" },
        "model_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" }
        },
        "prompts": {
          "type": "array",
          "items": { "$ref": "#/$defs/VersionedHash" }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/VersionedHash" }
        },
        "agent_specs": {
          "type": "array",
          "items": { "$ref": "#/$defs/VersionedHash" }
        }
      }
    },
    "RunHarness": {
      "description": "Everything that shaped one run's behavior, across all of its segments (ADR-0033). The session log is the source: builds from each claim's job_state_changed, prompts, skills and agent specs from context_assembled, models from model_call_completed. The continuation keeps it as a cache.",
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_builds", "model_ids", "prompts", "skills", "agent_specs"],
      "properties": {
        "harness_builds": {
          "description": "One entry per run segment, in the order the segments ran.",
          "type": "array",
          "items": { "$ref": "#/$defs/NonEmptyString" }
        },
        "model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/NonEmptyString" }
        },
        "prompts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/VersionedHash" }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/VersionedHash" }
        },
        "agent_specs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/VersionedHash" }
        }
      }
    },
    "Fidelity": {
      "description": "A fidelity level of the synthesis process (blueprint section 5.1): L0 requirements, L1 concept and architecture, L2 sizing and performance, L3 detailed analysis, L4 embodiment and artifacts.",
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "ContextSectionName": {
      "description": "A section of an assembled model context (blueprint section 8), listed in the order the model sees them.",
      "type": "string",
      "enum": [
        "instructions",
        "task_contract",
        "job_state",
        "design_state",
        "run_history",
        "untrusted_content",
        "open_turn"
      ]
    },
    "Narrative": {
      "description": "Model-written text. Untrusted, and never the source of a number or status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin"],
      "properties": {
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "origin": { "type": "string", "enum": ["model"] }
      }
    }
  }
}
