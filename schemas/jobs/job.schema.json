{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "description": "A persisted unit of pending work (blueprint section 6.1). In Increment 1 each run is one job. Remaining budget is task.budget minus budget_used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "project_id",
    "status",
    "task",
    "idempotency_key",
    "attempt",
    "created_at",
    "updated_at",
    "sdr_base_version",
    "progress",
    "pending_work",
    "artifact_ids",
    "budget_used"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.2"] },
    "id": { "$ref": "../common/types.schema.json#/$defs/JobId" },
    "run_id": { "$ref": "../common/types.schema.json#/$defs/RunId" },
    "project_id": { "$ref": "../common/types.schema.json#/$defs/ProjectId" },
    "status": { "$ref": "#/$defs/JobStatus" },
    "task": { "$ref": "../tasks/task.schema.json" },
    "idempotency_key": { "$ref": "../common/types.schema.json#/$defs/Identifier" },
    "attempt": {
      "description": "How many times the job has been claimed.",
      "type": "integer",
      "minimum": 0
    },
    "created_at": { "$ref": "../common/types.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "../common/types.schema.json#/$defs/Timestamp" },
    "sdr_base_version": { "$ref": "../common/types.schema.json#/$defs/SdrVersion" },
    "progress": { "$ref": "#/$defs/JobProgress" },
    "pending_work": {
      "description": "Human-readable description of outstanding work. Recovery uses step records and the event log, not this list.",
      "type": "array",
      "items": { "$ref": "../common/types.schema.json#/$defs/NonEmptyString" }
    },
    "artifact_ids": {
      "type": "array",
      "items": { "$ref": "../common/types.schema.json#/$defs/ArtifactId" }
    },
    "budget_used": { "$ref": "../common/types.schema.json#/$defs/Usage" },
    "lease": { "$ref": "#/$defs/Lease" }
  },
  "$defs": {
    "JobState": {
      "type": "string",
      "enum": ["queued", "running", "waiting", "suspended", "completed", "failed", "cancelled"]
    },
    "JobStatus": {
      "description": "The job's state, tagged by `state`, with what that state needs. A stop reason the state implies is not stored: suspended means approval_required, cancelled means cancelled. Every state a worker leaves running into names the checkpoint it rests on.",
      "oneOf": [
        {
          "description": "Waiting to be claimed. After a wake-up or a requeue it names the checkpoint the run resumes from; after a submit there is none.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "const": "queued" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        },
        {
          "description": "Claimed by a worker, which holds its lease.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "const": "running" }
          }
        },
        {
          "description": "Parked until its wake condition is met.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "wake_condition", "checkpoint"],
          "properties": {
            "state": { "const": "waiting" },
            "wake_condition": { "$ref": "#/$defs/WakeCondition" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        },
        {
          "description": "Parked until a human answers its approval (blueprint section 6.4); the run stopped with approval_required.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "wake_condition", "checkpoint"],
          "properties": {
            "state": { "const": "suspended" },
            "wake_condition": { "$ref": "#/$defs/WakeCondition" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        },
        {
          "description": "The run stopped for good.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "stop_reason", "checkpoint"],
          "properties": {
            "state": { "const": "completed" },
            "stop_reason": { "$ref": "#/$defs/CompletedStopReason" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        },
        {
          "description": "The run stopped because it was cancelled.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "checkpoint"],
          "properties": {
            "state": { "const": "cancelled" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        },
        {
          "description": "The harness could not run the job to a stop.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "failure", "checkpoint"],
          "properties": {
            "state": { "const": "failed" },
            "failure": { "$ref": "#/$defs/JobFailure" },
            "checkpoint": { "$ref": "#/$defs/CheckpointRef" }
          }
        }
      ]
    },
    "CompletedStopReason": {
      "description": "The stop reasons of a completed job (blueprint section 5.4).",
      "type": "string",
      "enum": ["success", "failure", "budget_exhausted"]
    },
    "CheckpointRef": {
      "description": "The continuation record a status rests on, as the job store holds it: its checkpoint number and the sha256 of its canonical JSON.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "../common/types.schema.json#/$defs/Sha256" }
      }
    },
    "JobFailure": {
      "description": "Why the harness gave up on a job: its attempts ran out, or it hit an error that retrying cannot fix.",
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "kind"],
      "properties": {
        "error": { "$ref": "../common/types.schema.json#/$defs/ErrorInfo" },
        "kind": { "type": "string", "enum": ["attempts_exhausted", "harness_error"] }
      }
    },
    "JobProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps_completed", "last_event_seq"],
      "properties": {
        "steps_completed": { "type": "integer", "minimum": 0 },
        "last_event_seq": {
          "description": "Sequence number of the last event written for this run; 0 before the first.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WakeCondition": {
      "description": "What a waiting or suspended job is waiting for. A cancel wakes any job regardless.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "approval_id"],
          "properties": {
            "kind": { "const": "approval_answered" },
            "approval_id": { "$ref": "../common/types.schema.json#/$defs/ApprovalId" }
          }
        }
      ]
    },
    "Lease": {
      "description": "Held by the worker running the job and renewed by heartbeat. An expired lease means the job was interrupted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "acquired_at", "expires_at", "heartbeat_at"],
      "properties": {
        "holder": { "$ref": "../common/types.schema.json#/$defs/Identifier" },
        "acquired_at": { "$ref": "../common/types.schema.json#/$defs/Timestamp" },
        "expires_at": { "$ref": "../common/types.schema.json#/$defs/Timestamp" },
        "heartbeat_at": { "$ref": "../common/types.schema.json#/$defs/Timestamp" }
      }
    }
  }
}
