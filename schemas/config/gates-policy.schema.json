{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatesPolicy",
  "description": "config/policies/gates.yaml: what each design acceptance gate requires.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sdr_commit"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1"] },
    "sdr_commit": { "$ref": "#/$defs/SdrCommitGate" }
  },
  "$defs": {
    "SdrCommitGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks"],
      "properties": {
        "required_checks": {
          "description": "Checks that must pass before a transition commits.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/types.schema.json#/$defs/CheckId" }
        }
      }
    }
  }
}
