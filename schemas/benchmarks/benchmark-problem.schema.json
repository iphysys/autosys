{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkProblem",
  "description": "One benchmark problem in evals/benchmarks/<split>/<id>/problem.yaml (blueprint section 14.7, ADR-0025). Written by the team, never by the improvement loop. Values are encoded as the source specification states them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "split",
    "status",
    "source",
    "feasibility",
    "description",
    "givens",
    "design_variables",
    "derived_parameters",
    "requirements",
    "budgets",
    "expected_outcomes"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1"] },
    "id": {
      "description": "Equals the name of the problem's directory.",
      "$ref": "../common/types.schema.json#/$defs/Identifier"
    },
    "split": {
      "description": "Held-out problems are never stored in the repository (blueprint section 9.4), so only dev appears here.",
      "type": "string",
      "enum": ["dev"]
    },
    "status": {
      "description": "placeholder: drafted to exercise the harness; the team has not yet reviewed the values for a recorded baseline.",
      "type": "string",
      "enum": ["placeholder", "approved"]
    },
    "source": {
      "description": "Repository-relative path of the specification this file encodes.",
      "$ref": "../common/types.schema.json#/$defs/NonEmptyString"
    },
    "feasibility": {
      "description": "infeasible: no design meets every must-level requirement, so the run must never stop with success.",
      "type": "string",
      "enum": ["solvable", "infeasible"]
    },
    "description": { "$ref": "../common/types.schema.json#/$defs/NonEmptyString" },
    "givens": {
      "description": "Fixed facts of the problem.",
      "type": "array",
      "items": { "$ref": "#/$defs/BenchmarkGiven" }
    },
    "design_variables": {
      "description": "Parameters the agent chooses.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/BenchmarkParameter" }
    },
    "derived_parameters": {
      "description": "Parameters that tools compute from the design variables.",
      "type": "array",
      "items": { "$ref": "#/$defs/BenchmarkParameter" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/BenchmarkRequirement" }
    },
    "budgets": { "$ref": "#/$defs/BenchmarkBudgets" },
    "expected_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ExpectedOutcome" }
    },
    "notes": {
      "description": "Explanation for human reviewers. Never part of an agent's task: it may contain hints towards the solution.",
      "$ref": "../common/types.schema.json#/$defs/NonEmptyString"
    }
  },
  "$defs": {
    "BenchmarkGiven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "quantity"],
      "properties": {
        "id": { "$ref": "../common/types.schema.json#/$defs/ElementId" },
        "text": {
          "description": "The given as the specification states it.",
          "$ref": "../common/types.schema.json#/$defs/NonEmptyString"
        },
        "quantity": { "$ref": "../common/quantity.schema.json#/$defs/Quantity" }
      }
    },
    "BenchmarkParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "text", "unit"],
      "properties": {
        "parameter_id": {
          "description": "The SDR parameter that holds this value.",
          "$ref": "../common/types.schema.json#/$defs/ElementId"
        },
        "text": { "$ref": "../common/types.schema.json#/$defs/NonEmptyString" },
        "unit": { "$ref": "../common/quantity.schema.json#/$defs/Unit" }
      }
    },
    "BenchmarkRequirement": {
      "description": "A requirement the run's SDR starts with. numeric uses the requirement check's criteria (ADR-0021).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "quantity", "priority", "numeric"],
      "properties": {
        "id": { "$ref": "../common/types.schema.json#/$defs/ElementId" },
        "text": { "$ref": "../common/types.schema.json#/$defs/NonEmptyString" },
        "quantity": {
          "description": "The constrained quantity as the specification names it.",
          "$ref": "../common/types.schema.json#/$defs/NonEmptyString"
        },
        "priority": { "$ref": "../sdr/requirement.schema.json#/$defs/RequirementPriority" },
        "numeric": { "$ref": "../sdr/requirement.schema.json#/$defs/NumericRequirement" }
      }
    },
    "BenchmarkBudgets": {
      "description": "Limits for one run of the problem. Token and cost limits are added when the specification sets them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_wall_time", "max_repair_attempts_per_step"],
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_wall_time": { "$ref": "../common/quantity.schema.json#/$defs/Quantity" },
        "max_repair_attempts_per_step": { "type": "integer", "minimum": 1 }
      }
    },
    "ExpectedOutcome": {
      "description": "One checkable outcome. statement is the specification's wording; checks are how an evaluation decides it from the run's evidence, SDR and event log. The outcome holds when every check holds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "checks"],
      "properties": {
        "id": { "$ref": "../common/types.schema.json#/$defs/Identifier" },
        "statement": { "$ref": "../common/types.schema.json#/$defs/NonEmptyString" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OutcomeCheck" }
        }
      }
    },
    "OutcomeCheck": {
      "oneOf": [
        {
          "description": "The run stops with one of these reasons.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "allowed"],
          "properties": {
            "kind": { "const": "stop_reason" },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "../common/types.schema.json#/$defs/StopReason" }
            }
          }
        },
        {
          "description": "The final SDR version holds each parameter, with a unit.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parameter_ids"],
          "properties": {
            "kind": { "const": "parameters_present" },
            "parameter_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "../common/types.schema.json#/$defs/ElementId" }
            }
          }
        },
        {
          "description": "In the final SDR version, each requirement has passing evidence from the checks.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "requirement_ids"],
          "properties": {
            "kind": { "const": "requirements_passing" },
            "requirement_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "../common/types.schema.json#/$defs/ElementId" }
            }
          }
        },
        {
          "description": "No committed SDR version shows the requirement as passing.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "requirement_id"],
          "properties": {
            "kind": { "const": "requirement_never_passing" },
            "requirement_id": { "$ref": "../common/types.schema.json#/$defs/ElementId" }
          }
        },
        {
          "description": "The final value of a parameter, in unit, is within relative_tolerance of expression evaluated on the final values of variables, each in its unit.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parameter_id", "unit", "expression", "variables", "relative_tolerance"],
          "properties": {
            "kind": { "const": "parameter_matches_reference" },
            "parameter_id": { "$ref": "../common/types.schema.json#/$defs/ElementId" },
            "unit": { "$ref": "../common/quantity.schema.json#/$defs/Unit" },
            "expression": { "$ref": "#/$defs/ReferenceExpression" },
            "variables": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/BenchmarkParameterUnit" }
            },
            "relative_tolerance": { "$ref": "../common/quantity.schema.json#/$defs/Quantity" }
          }
        },
        {
          "description": "The approval required by this rule of config/policies/autonomy.yaml was requested and answered.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "approval_rule"],
          "properties": {
            "kind": { "const": "approval_answered" },
            "approval_rule": { "$ref": "../common/types.schema.json#/$defs/Identifier" }
          }
        }
      ]
    },
    "ReferenceExpression": {
      "description": "Arithmetic only: decimal numbers, variable parameter IDs, pi, + - * / ^ and parentheses. Data, not code: it is parsed by the benchmark loader and never executed.",
      "type": "string",
      "pattern": "^[0-9A-Za-z_.+*/^() -]{1,256}$"
    },
    "BenchmarkParameterUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "unit"],
      "properties": {
        "parameter_id": { "$ref": "../common/types.schema.json#/$defs/ElementId" },
        "unit": { "$ref": "../common/quantity.schema.json#/$defs/Unit" }
      }
    }
  }
}
